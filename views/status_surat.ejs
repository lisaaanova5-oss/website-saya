<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Status Surat - UNIMARCH</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="layout">
    <%- include('partials/sidebar', { aktif: aktif }) %>
    <div class="konten">
        <div class="topbar">
            <h2>Status Surat</h2>
            <span>Halo, <%= nama %></span>
        </div>

        <div class="bar-atas">
            <form method="GET" action="/status" class="form-cari">
                <input type="text" name="q" value="<%= keyword %>"
                       placeholder="Cari nomor surat atau perihal...">
                <button type="submit" class="btn-kecil">Cari</button>
            </form>
        </div>

        <table class="tabel">
            <thead>
                <tr>
                    <th>No</th><th>Jenis</th><th>Nomor Surat</th><th>Perihal</th>
                    <th>Tanggal</th><th>Status</th><th>Disposisi Terakhir</th><th>Riwayat</th>
                </tr>
            </thead>
            <tbody>
            <% if (daftar.length === 0) { %>
                <tr><td colspan="8" class="kosong">Belum ada data surat.</td></tr>
            <% } %>
            <% daftar.forEach(function (s, i) { %>
                <tr>
                    <td><%= i + 1 %></td>
                    <td><%= ucfirst(s.jenis) %></td>
                    <td><%= s.nomor_surat %></td>
                    <td><%= s.perihal %></td>
                    <td><%= tgl(s.tanggal) %></td>
                    <td><span class="badge <%= s.status.toLowerCase() %>"><%= s.status %></span></td>
                    <td><%= s.tujuan_terakhir ? s.tujuan_terakhir : '-' %></td>
                    <td>
                        <a href="/status?id=<%= s.id_surat %>#riwayat" class="link-riwayat">
                            Lihat (<%= s.jumlah_disposisi %>)
                        </a>
                    </td>
                </tr>
            <% }); %>
            </tbody>
        </table>

        <% if (suratLihat) { %>
            <div class="form-kartu riwayat" id="riwayat">
                <h3>Riwayat Disposisi</h3>
                <p><strong><%= suratLihat.nomor_surat %></strong> - <%= suratLihat.perihal %></p>
                <% if (riwayat.length === 0) { %>
                    <p>Surat ini belum pernah didisposisikan.</p>
                <% } %>
                <% riwayat.forEach(function (r) { %>
                    <div class="item-riwayat">
                        <strong><%= r.tujuan %></strong>
                        <span class="badge <%= r.status.toLowerCase() %>"><%= r.status %></span><br>
                        <small><%= tgl(r.tanggal_disposisi) %></small>
                        <% if (r.catatan) { %>
                            <div><%= r.catatan %></div>
                        <% } %>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>
</div>
</body>
</html>